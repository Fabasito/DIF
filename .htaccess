DirectoryIndex index.php index.html

# Page d'erreur personnalisée
ErrorDocument 404 /404.php

# Empêche l'accès web direct aux includes PHP
<IfModule mod_authz_core.c>
  <FilesMatch "\.(tmp)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(tmp)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
